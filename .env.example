# Chaos Simulator — environment variables
# Copy this file to .env.local and adjust as needed.
# All variables are OPTIONAL for local dev — defaults work out of the box.

# URL of the chaos-engine backend (only needed when not using Next rewrites)
# Leave empty for local dev — Next.js rewrite proxies /socket.io to localhost:3030.
# NEXT_PUBLIC_CHAOS_ENGINE_URL=https://chaos-engine.example.com
NEXT_PUBLIC_CHAOS_ENGINE_URL=

# CORS origin for the local chaos-engine (mini-services/chaos-engine)
# Local lab default is * (convenient, NOT safe on a public host).
# If you ever bind the engine beyond localhost, set an explicit origin, e.g.:
# CORS_ORIGIN=https://chaos-simulation.vercel.app
CORS_ORIGIN=*

# Port for the chaos engine (local default 3030)
PORT=3030
