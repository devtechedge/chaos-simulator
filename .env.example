# Chaos Simulator - environment variables
#
# The dashboard is a client-side simulation and needs no configuration to run.
# Nothing in src/ reads any variable below today. They are documented for the
# case where a separate, self-hosted control plane is added later.

# URL of a chaos-engine backend, if you stand one up separately.
# Leave empty (the default) and the app stays fully in-browser.
# NEXT_PUBLIC_CHAOS_ENGINE_URL=https://chaos-engine.example.com
NEXT_PUBLIC_CHAOS_ENGINE_URL=

# CORS origin for that engine. `*` is convenient for a localhost lab and is
# NOT safe on a public host. Set an explicit origin before exposing it.
# CORS_ORIGIN=https://chaos-simulation.vercel.app
CORS_ORIGIN=*

# Port for that engine (local default 3030)
PORT=3030
